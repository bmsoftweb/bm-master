# Porta do servidor local (npm run dev)
PORT=3000

# MySQL (valores reais só no .env local e nas variáveis da Vercel)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="usuario"
MYSQL_PASSWORD="senha"
# Mesmo database do bm-estoque (ERP BMsoft): o login é pelo sys_usuarios
MYSQL_DATABASE="bmerp_000000"

# Segredo da sessão (assina o token e cifra a credencial dos módulos): obrigatório, no mínimo 32 caracteres.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
